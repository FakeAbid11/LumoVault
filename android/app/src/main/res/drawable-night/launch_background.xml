<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch splash (dark mode): dark surface + centered app logo.
     The `night` qualifier outranks `v21`, so the dark-mode LaunchTheme
     resolves THIS drawable instead of the white one — dark users no longer
     get a white flash on cold start. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121212" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
